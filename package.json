{
  "name": "screen-plate-phase-checker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "陶瓷贴花印刷换网版定位孔相位校验（纯前端单页应用）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
